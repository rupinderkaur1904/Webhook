# Optional settings for `docker compose up`. Copy this file to .env and change what you need;
# without a .env file the defaults below apply.

# Host ports. Change one if something else on your machine already uses it.
APP_PORT=8080
SIMULATOR_PORT=9090
DB_PORT=5432

# The first dashboard account, created on the first start of a fresh database.
# The password needs at least 12 characters.
ADMIN_EMAIL=dev@localhost
ADMIN_PASSWORD=local-dev-password
