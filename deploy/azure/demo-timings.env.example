# Optional short timings for a live demo: copy to demo-timings.env and restart the app. Without the
# file the platform uses its production defaults (8 attempts, 30 s base delay up to 1 h, 30 s to 30 min
# circuit cool-down), so retries and the breaker take hours instead of seconds to watch.
# These match the local profile used by docker-compose.yml and scripts/demo.sh.
WEBHOOKS_DELIVERY_RESPONSE_TIMEOUT=5s
WEBHOOKS_WORKER_LEASE_DURATION=15s
WEBHOOKS_WORKER_REAPER_INTERVAL=2s
WEBHOOKS_RETRY_MAX_ATTEMPTS=4
WEBHOOKS_RETRY_BASE_DELAY=2s
WEBHOOKS_RETRY_MAX_DELAY=20s
WEBHOOKS_RETRY_MAX_RETRY_AFTER=60s
WEBHOOKS_CIRCUIT_BASE_COOLDOWN=5s
WEBHOOKS_CIRCUIT_MAX_COOLDOWN=1m
