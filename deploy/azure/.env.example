# Copy to .env on the VM (never commit it: .env is in .gitignore), fill in the blanks, then run
# ./new-secrets.sh to generate the secret values. Keep the file at mode 600.

# ---- Public address --------------------------------------------------------------------------------
# The VM's DNS name, e.g. relay-demo.centralindia.cloudapp.azure.com (public IP -> Configuration -> DNS name label).
RELAY_DOMAIN=
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# ---- Images (digests, from the "Images" workflow summary) ------------------------------------------
RELAY_APP_IMAGE=ghcr.io/rupinderkaur1904/webhook-platform@sha256:
# Only needed with --profile demo.
RELAY_SIMULATOR_IMAGE=ghcr.io/rupinderkaur1904/webhook-simulator@sha256:

# ---- Database (Azure Database for PostgreSQL Flexible Server, private access) -----------------------
DATABASE_URL=jdbc:postgresql://<server>.postgres.database.azure.com:5432/webhooks?sslmode=require
DATABASE_USERNAME=relay_app
DATABASE_PASSWORD=
# B1MS allows few connections; check with SHOW max_connections.
DATABASE_POOL_SIZE=8

# ---- Dashboard account -----------------------------------------------------------------------------
# The only account (self-registration is off). Changing these later adds another account.
BOOTSTRAP_EMAIL=
# Optional: a whk_ API key (36+ characters) created at start-up, for scripts/demo.sh. Leave empty
# and create keys in the dashboard instead if you prefer.
BOOTSTRAP_API_KEY=

# ---- Generated by new-secrets.sh (leave empty here) -------------------------------------------------
SECRET_ENCRYPTION_KEY=
BOOTSTRAP_PASSWORD=
METRICS_TOKEN=
SIMULATOR_CONTROL_TOKEN=

# ---- Optional ---------------------------------------------------------------------------------------
# Only when running the simulator (--profile demo): lets the platform deliver to it on the private network.
SSRF_ALLOWED_HOSTS=
# true for one restart to log each request's TCP peer and forwarding headers (verify.sh checks proxying).
PROXY_DIAGNOSTICS=false
