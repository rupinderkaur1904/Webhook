# Settings for compose.rehearsal.yml (local only). Run ./new-secrets.sh rehearsal.env to fill the secrets.
RELAY_DOMAIN=localhost
ACME_EMAIL=rehearsal@example.com
RELAY_APP_IMAGE=relay-app:rehearsal
RELAY_SIMULATOR_IMAGE=relay-sim:rehearsal
DATABASE_URL=jdbc:postgresql://db:5432/webhooks
DATABASE_USERNAME=relay_app
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=8
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_API_KEY=
SECRET_ENCRYPTION_KEY=
BOOTSTRAP_PASSWORD=
METRICS_TOKEN=
SIMULATOR_CONTROL_TOKEN=
SSRF_ALLOWED_HOSTS=simulator:9090
PROXY_DIAGNOSTICS=false
