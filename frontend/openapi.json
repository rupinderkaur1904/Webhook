  "components" : {
    "schemas" : {
      "CreateEventRequest" : {
        "type" : "object",
        "properties" : {
          "eventType" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "payload" : { },
          "endpointIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            },
            "maxItems" : 50,
            "minItems" : 0
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "eventType", "payload" ]
      },
      "AcceptedDelivery" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "endpointId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "RETRYING", "IN_FLIGHT", "DELIVERED", "DEAD_LETTERED", "CANCELLED" ]
          }
        },
        "required" : [ "endpointId", "id", "status" ]
      },
      "EventAcceptedResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "eventType" : {
            "type" : "string"
          },
          "idempotencyKey" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "deliveries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AcceptedDelivery"
            }
          }
        },
        "required" : [ "createdAt", "deliveries", "eventType", "id", "idempotencyKey" ]
      },
      "CreateEndpointRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "url" : {
            "type" : "string",
            "maxLength" : 2048,
            "minLength" : 0
          },
          "eventTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "pattern" : "^[a-z0-9]+([._-][a-z0-9]+)*(\\.\\*)?$"
            },
            "maxItems" : 50,
            "minItems" : 0
          }
        },
        "required" : [ "name", "url" ]
      },
      "CircuitView" : {
        "type" : "object",
        "properties" : {
          "state" : {
            "type" : "string",
            "enum" : [ "CLOSED", "OPEN", "HALF_OPEN" ]
          },
          "consecutiveFailures" : {
            "type" : "integer",
            "format" : "int32"
          },
          "openedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "retryAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          }
        },
        "required" : [ "consecutiveFailures", "openedAt", "retryAt", "state" ]
      },
      "EndpointCreatedResponse" : {
        "type" : "object",
        "properties" : {
          "endpoint" : {
            "$ref" : "#/components/schemas/EndpointResponse"
          },
          "secret" : {
            "type" : "string"
          }
        },
        "required" : [ "endpoint", "secret" ]
      },
      "EndpointHealth" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "DISABLED", "FAILING", "DEGRADED", "HEALTHY", "NO_DATA" ]
          },
          "window" : {
            "type" : "string",
            "enum" : [ "1h", "24h", "7d" ]
          },
          "attempts" : {
            "type" : "integer",
            "format" : "int64"
          },
          "failedAttempts" : {
            "type" : "integer",
            "format" : "int64"
          },
          "successRate" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "latencyP50Ms" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "latencyP95Ms" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "deadLetters" : {
            "type" : "integer",
            "format" : "int64"
          },
          "lastSuccessAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "lastFailure" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/LastFailure"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "attempts", "deadLetters", "failedAttempts", "lastFailure", "lastSuccessAt", "latencyP50Ms", "latencyP95Ms", "status", "successRate", "window" ]
      },
      "EndpointResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "url" : {
            "type" : "string"
          },
          "eventTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "enabled" : {
            "type" : "boolean"
          },
          "secretPrefix" : {
            "type" : "string"
          },
          "previousSecretExpiresAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "circuit" : {
            "$ref" : "#/components/schemas/CircuitView"
          },
          "health" : {
            "$ref" : "#/components/schemas/EndpointHealth"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
